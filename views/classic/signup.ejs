<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Create account | Commonplace</title>
    <link rel="stylesheet" href="/classic-assets/style.css">
</head>
<body>
    <header class="site-header"><nav class="container nav"><a class="brand" href="/classic">Commonplace <span class="edition">EJS edition</span></a><div class="nav-links"><a href="/">React edition</a><a href="/classic/signin">Sign in</a></div></nav></header>
    <main class="container narrow">
        <section class="panel auth-panel">
            <p class="eyebrow">Join the conversation</p><h1>Create your account</h1>
            <% if (error) { %><p class="message error" role="alert"><%= error %></p><% } %>
            <form action="/classic/signup" method="POST" class="form-stack">
                <label for="user_id">User ID</label><input id="user_id" name="user_id" maxlength="255" autocomplete="username" required>
                <label for="name">Name</label><input id="name" name="name" maxlength="255" autocomplete="name" required>
                <label for="password">Password</label><input id="password" name="password" type="password" minlength="8" maxlength="72" autocomplete="new-password" required>
                <p class="hint">Use at least 8 characters. Passwords are stored securely as hashes.</p>
                <button class="button primary" type="submit">Create account</button>
            </form>
            <p class="form-footer">Already have an account? <a href="/classic/signin">Sign in</a>.</p>
        </section>
    </main>
</body>
</html>
