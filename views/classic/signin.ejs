<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sign in | Commonplace</title>
    <link rel="stylesheet" href="/classic-assets/style.css">
</head>
<body>
    <header class="site-header"><nav class="container nav"><a class="brand" href="/classic">Commonplace <span class="edition">EJS edition</span></a><div class="nav-links"><a href="/">React edition</a><a href="/classic/signup">Create account</a></div></nav></header>
    <main class="container narrow">
        <section class="panel auth-panel">
            <p class="eyebrow">Welcome back</p><h1>Sign in</h1>
            <% if (error) { %><p class="message error" role="alert"><%= error %></p><% } %>
            <% if (notice) { %><p class="message success" role="status"><%= notice %></p><% } %>
            <form action="/classic/signin" method="POST" class="form-stack">
                <label for="user_id">User ID</label><input id="user_id" name="user_id" maxlength="255" autocomplete="username" required>
                <label for="password">Password</label><input id="password" name="password" type="password" autocomplete="current-password" required>
                <button class="button primary" type="submit">Sign in</button>
            </form>
            <p class="form-footer">New here? <a href="/classic/signup">Create an account</a>.</p>
        </section>
    </main>
</body>
</html>
